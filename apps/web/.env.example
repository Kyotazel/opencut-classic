# Environment variables example
# Copy this file to .env.local and update the values as needed

# Node
NODE_ENV=development

# Public
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MARBLE_API_URL=https://api.marblecms.com

# Server
DATABASE_URL="mysql://root@localhost:3306/klip"
BETTER_AUTH_SECRET=your_better_auth_secret

UPSTASH_REDIS_REST_URL=http://localhost:8079
UPSTASH_REDIS_REST_TOKEN=example_token

MARBLE_WORKSPACE_KEY=your_workspace_key_here

FREESOUND_CLIENT_ID=your_client_id_here
FREESOUND_API_KEY=your_api_key_here

# Klip batch (ZIP -> template -> publish)
# Pemilik batch yang dicatat di klip_batches.owner_user_id.
# Kosong = pakai APP_USER. Isi kalau batch bukan milik orang (mis. dari API).
KLIP_OWNER_ID=

# WAJIB untuk publish Instagram. Harus menunjuk domain PUBLIK yang melayani
# aplikasi ini, karena server Meta yang mengunduh MP4-nya dari
# <KLIP_PUBLIC_BASE_URL>/api/klip/publishes/<id>/video.
#
# Salah isi = publish gagal dengan "Instagram gagal memproses video" dan
# container berstatus ERROR, tanpa penjelasan lain dari Meta. Pastikan URL-nya
# benar-benar bisa diunduh dari internet (bukan localhost, bukan domain lain).
#
# Lokal: publish tidak bisa berhasil tanpa terowongan publik. Uji publish di
# server, atau render saja (biarkan default_ig_account_id kosong).
KLIP_PUBLIC_BASE_URL=

# URL internal aplikasi yang dipakai worker (Chromium) untuk membuka
# /internal/batch-job. Di server biasanya port PM2 aplikasi.
KLIP_WORKER_BASE_URL=http://127.0.0.1:6050
